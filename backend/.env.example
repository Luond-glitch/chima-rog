# ───────────────────────────────────────────────────────────────
# CHIMA backend configuration.  Copy this file to `.env` and edit.
# NEVER commit the real `.env` file.
# ───────────────────────────────────────────────────────────────

FLASK_ENV=development
# Change this to a long random string in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. SQLite works out of the box; for production use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/chima
DATABASE_URL=sqlite:///chima.db

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=https://chima-cbo.vercel.app/

# First admin account (created automatically on first run)
ADMIN_EMAIL=admin@chima.or.ke
ADMIN_PASSWORD=ChangeMe!2026

# ═══════════════════════════════════════════════════════════════
#  SUPABASE FILE STORAGE  ←←←  ADD YOUR REAL SUPABASE KEYS HERE
# ═══════════════════════════════════════════════════════════════
# 1. Supabase dashboard → Project Settings → API → "Project URL"
SUPABASE_URL=https://hhrbjpdvdvpexrboigkg.supabase.co
# 2. Same page → "service_role" secret key  (server-side only! never put it in the frontend)
SUPABASE_SERVICE_KEY=sb_publishable_eOQlGq1i5XRx3aQ11ODEGw_eOvwM1DY
# 3. Storage → create a bucket (set it to Public) and put its name here
SUPABASE_BUCKET=chima-media

# Max upload size in megabytes
MAX_UPLOAD_MB=25
